<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" controllerName="MDM_QIR.controller.Analytics"
	xmlns:html="http://www.w3.org/1999/xhtml" xmlns:grid="sap.ui.layout">
	<Page title="Title" showHeader="false" class="sapUiSizeCompact cl_background" enableScrolling="false">
		<!--<core:Fragment fragmentName="MDM_QIR.Fragments.SideNavBar" type="XML"/>-->
		<Toolbar height="3rem" class="cl_header sapUiLargeMarginBegin ">
			<Text text="{i18n>title}" class="cl_headerTitle sapUiTinyMarginBegin "/>
			<HBox alignContent="Center" justifyContent="Center" alignItems="Center" height="1.8rem" class="sapUiMediumMarginBegin cl_headermenu">
				<Button icon="{= ${JM_ImageModel>/path} + 'DashboardWhite.svg'}" text="{i18n>Dashboard}" tooltip="{i18n>Dashboard}" press="fnDashboard"
					class="cl_iconBtn cl_focusbtn cl_tranBtn"/>
				<Button icon="{= ${JM_ImageModel>/path} + 'AnalyticchartBlue.svg'}" text="{i18n>Analytics}" tooltip="{i18n>Analytics}" press="fnAnalytics"
					class="cl_iconBtn cl_focusbtn cl_dashbtn sapUiSmallMarginBegin"/>
				<Button icon="{= ${JM_ImageModel>/path} + 'Comparechart.svg'}" text="{i18n>Compare}" tooltip="{i18n>Compare}" press="fnCompare"
					class="cl_iconBtn cl_focusbtn cl_tranBtn sapUiSmallMarginBeginEnd"/>
			</HBox>
			<ToolbarSpacer/>
			<HBox alignItems="Center">
				<Select id="UID_APPID" selectedKey="Q" items="{JM_AppIdModel>/List}" class="cl_ar_combobox" width="9rem" change="fnDataLoad">
					<core:Item key="{JM_AppIdModel>DomvalueL}" text="{JM_AppIdModel>Ddtext}"/>
				</Select>
				<Label text="{i18n>From}" class="sapUiTinyMarginBeginEnd cl_userid_font"></Label>
				<DatePicker id="DID_FDATE" displayFormat="dd.MM.yyyy" width="7rem" class="cl_ar_inputField" valueFormat="yyyy-MM-ddTHH:mm:ss"
					change="fnDataLoad" placeholder=" "/>
				<Label text="{i18n>To}" class="sapUiTinyMarginBegin cl_userid_font"></Label>
				<DatePicker id="DID_TDATE" displayFormat="dd.MM.yyyy" valueFormat="yyyy-MM-ddTHH:mm:ss" placeholder=" " width="7rem" change="fnDataLoad"
					class="sapUiTinyMarginBegin cl_ar_inputField"/>
				<Select forceSelection="false" id="UID_CUSTOM" items="{JMDate>/}" class="sapUiTinyMarginBegin cl_ar_combobox" width="6rem"
					change="fnDateSelection">
					<core:Item key="{JMDate>Range}" text="{JMDate>Value}"/>
				</Select>
				<Label text="{JM_UserModel>/Sysid} - {JM_UserModel>/Uname}" class="cl_userid_font sapUiSmallMarginBeginEnd"/>
				<Image src="{= ${JM_ImageModel>/path} + 'Companylogo.svg'}" class="sapUiSmallMarginEnd" width="1rem"></Image>
			</HBox>
		</Toolbar>
		<content>
			<VBox class="cl_side">
				<core:Fragment fragmentName="MDM_QIR.Fragments.SideNavBar" type="XML"/>
			</VBox>
			<ScrollContainer height="100%" vertical="true" horizontal="false">
				<VBox class="sapUiLargeMarginBegin">
					<grid:Grid class="sapUiSmallMarginTopBottom sapUiTinyMarginBeginEnd">
						<VBox class="cl_chartoutline ">
							<Toolbar class="cl_bordertool sapUiTinyMarginTop">
								<Image src="{= ${JM_ImageModel>/path} + 'MySLA.svg'}" width="1.6rem"/>
								<Text text="{i18n>MYSLA}" class="cl_charttitle"/>
							</Toolbar>
							<VBox class="sapUiTinyMarginBottom">
								<core:HTML content="&lt;div id='chart' style='width:100%'&gt;&lt;/div&gt;"/>
							</VBox>
							<layoutData>
								<grid:GridData span="L2 M12 S12"/>
							</layoutData>
						</VBox>
						<VBox class="cl_chartoutline">
							<Toolbar class="cl_bordertool sapUiTinyMarginTop ">
								<Image src="{= ${JM_ImageModel>/path} + 'RequestSLA.svg'}" width="1.6rem"/>
								<Text text="{i18n>ReqSLA}" class="cl_charttitle"/>
								<ToolbarSpacer/>
								<ComboBox id="ID_TRANS" items="{JMTrans>/}" class="cl_input cl_inputmain" width="9rem" change="fnGetData">
									<core:Item key="{JMTrans>Transid}" text="{JMTrans>Transid}"/>
								</ComboBox>
							</Toolbar>
							<FlexBox height="2.5rem" alignItems="Start" justifyContent="SpaceBetween" class="cl_borderboxdata sapUiTinyMargin">
								<VBox class="sapUiTinyMarginBegin">
									<Text id="id_startdate" class="cl_TextCTitle"/>
									<Text text="{i18n>StartDate}" class="cl_TextChart"/>
								</VBox>
								<VBox alignContent="Center" justifyContent="Center" alignItems="Center">
									<Text id="id_totaltime" class="cl_TextCTitle"/>
									<Text text="{i18n>TotalTime}" class="cl_TextChart"/>
								</VBox>
								<VBox class="sapUiTinyMarginEnd">
									<Text id="id_enddate" class="cl_TextCTitle"/>
									<Text text="{i18n>EndDate}" class="cl_TextChart"/>
								</VBox>
							</FlexBox>
							<VBox class="sapUiSmallMarginBottom">
								<core:HTML content="&lt;div id='columnchart' style=&gt;&lt;/div&gt;"/>
							</VBox>
							<layoutData>
								<grid:GridData span="L5 M12 S12"/>
							</layoutData>
						</VBox>
						<VBox class="cl_chartoutline ">
							<Toolbar class="cl_bordertool sapUiTinyMarginTop">
								<Image src="{= ${JM_ImageModel>/path} + 'LevelSLA.svg'}" width="1.6rem"/>
								<Text text="{i18n>LevelSLA}" class="cl_charttitle"/>
								<ToolbarSpacer/>
								<ComboBox items="{JMUser>/}" class="cl_input cl_inputmain" id="id_leveluser" width="9rem" change="fnGetData">
									<core:Item key="{JMUser>Userid}" text="{JMUser>Userid}"/>
								</ComboBox>
							</Toolbar>
							<VBox class=" sapUiSmallMarginEnd">
								<core:HTML content="&lt;div id='linechart' style='width:100%'&gt;&lt;/div&gt;"/>
							</VBox>
							<layoutData>
								<grid:GridData span="L5 M12 S12"/>
							</layoutData>
						</VBox>
						<VBox class="cl_chartoutline">
							<Toolbar class="cl_bordertool sapUiTinyMarginTop">
								<Image src="{= ${JM_ImageModel>/path} + 'OntimeEsc.svg'}" width="1.6rem"/>
								<Text text="{i18n>OntimeEsc}" class="cl_charttitle"/>
								<ToolbarSpacer/>
								<ComboBox items="{JMUser>/}" class="cl_input cl_inputmain" id="id_ontimeuser" width="9rem" change="fnGetData">
									<core:Item key="{JMUser>Userid}" text="{JMUser>Userid}"/>
								</ComboBox>
							</Toolbar>
							<VBox >
								<core:HTML content="&lt;div id='Stackedchart' style='width:100%'&gt;&lt;/div&gt;"/>
							</VBox>
							<layoutData>
								<grid:GridData span="L10 M12 S12"/>
							</layoutData>
						</VBox>
						<VBox class="cl_chartoutline ">
							<Toolbar class="cl_bordertool sapUiTinyMarginTop">
								<Image src="{= ${JM_ImageModel>/path} + 'ChangeLogDB.svg'}" width="1.6rem"/>
								<Text text="{i18n>ChangeLog}" class="cl_charttitle"/>
							</Toolbar>
							<VBox >
								<core:HTML content="&lt;div id='idchangelog' style='width:100%'&gt;&lt;/div&gt;"/>
							</VBox>
							<HBox alignContent="Center" justifyContent="Center" alignItems="Center" class="sapUiSmallMarginBottom">
								<Button text="{i18n>ChangeLog}" press="fnChangeLog" icon="{= ${JM_ImageModel>/path} + 'ChgLog.svg'}"
									class="cl_iconBtn cl_focusbtn cl_primaryBtn"></Button>
							</HBox>
							<layoutData>
								<grid:GridData span="L2 M12 S12"/>
							</layoutData>
						</VBox>
					</grid:Grid>
				</VBox>
			</ScrollContainer>
		</content>
	</Page>
</mvc:View>