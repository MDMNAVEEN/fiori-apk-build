<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog contentWidth="25%" class="cl_customBottomDialog" showHeader="false">
		<Toolbar height="4.5rem" class="cl_bordertool sapUiTinyMarginBottom">
			<VBox id="id_snackbarBorder" class="cl_snackbarborderSucc"/>
			<Image src="{JMMessage>/ImgIcon}" class="sapUiSmallMarginBegin" width="2.1rem"/>
			<VBox class="sapUiTinyMarginBegin" width="100%">
				<Text text="{JMMessage>/MsgType}" id="id_snackbarHeader"/>
				<Text text="{JMMessage>/Message}" class="cl_snackbarInfoText sapUiTinyMarginTop"/>
			</VBox>
			<ToolbarSpacer/>
			<Image src="{= ${JM_ImageModel>/path} + 'Exit.svg'}" width="1rem" class="sapUiSmallMarginEnd cl_imgFocus" press="fnCloseSnackbar"/>
		</Toolbar>
	</Dialog>
</core:FragmentDefinition>