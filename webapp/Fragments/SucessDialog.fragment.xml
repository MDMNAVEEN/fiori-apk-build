<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog title="Confirmation Dialog" showHeader="false" class="cl_confirmationSuccessDialog sapUiSizeCompact" >
		<customHeader>
			<Toolbar class="cl_SuccessToolbar " height="2.5rem">
				<Text text="Success" class="cl_SuccessTitle sapUiTinyMarginTopBottom"/>
			</Toolbar>
		</customHeader>
		<VBox width="100%" justifyContent="Center">
			<HBox justifyContent="Center" class="sapUiTinyMarginTop">
				<Image src="{= ${JM_ImageModel>/path} + 'Success.gif'}" class="sapUiTinyMarginTop" alt="Loading animation" width="80px" height="80px"/>
			</HBox>
			<Text text="{JM_Popup>/text}" class="sapUiSmallMargin cl_SuccessTxt"></Text>
		</VBox>
		<buttons>
			<Button text="{JM_Popup>/positiveButton}" tooltip="{JM_Popup>/positiveButton}" icon="{JM_Popup>/positiveIcon}" class=" cl_iconBtn cl_pribtn sapUiSmallMarginEnd" press="fnRefresh"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>