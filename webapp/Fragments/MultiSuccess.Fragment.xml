<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog id="idMessageDialog" showHeader="false" class="cl_DesDupDialog sapUiSizeCompact" contentHeight="400px" contentWidth="600px"
		verticalScrolling="false" horizontalScrolling="false">
		<customHeader>
			<Toolbar class="cl_DupDialogToolbar"  height="2.5rem">
				<ToolbarSpacer/>
				<Text text="{JM_FinalmsgModel>/Title}" class=" sapUiTinyMarginTopBottom"/>
				<ToolbarSpacer/>
			</Toolbar>
		</customHeader>
		<content>
			<MessageView id="idMessageView" items="{ path: 'JM_FinalmsgModel>/messages' }">
				<items>
					<MessageItem type="{JM_FinalmsgModel>type}" title="{JM_FinalmsgModel>title}" subtitle="{JM_FinalmsgModel>subtitle}"/>
				</items>
			</MessageView>
		</content>
		<endButton>
			<Button text="{i18n>Ok}" icon="Images/Continue.svg" class="sapUiSizeCompact cl_pribtn sapUiSmallMarginEnd"
				press="fnCloseErrorSuccessDialog"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>